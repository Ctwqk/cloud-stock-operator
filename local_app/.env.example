# Environment for running the web UI / trade worker by hand against a DEPLOYED stack.
# (local_app/run_against_aws.sh fills all of this from the CloudFormation outputs.)
# The default `docker compose` demo needs none of it.
AWS_DEFAULT_REGION=us-west-1
AWS_PROFILE=default

TABLE_NAME=TradingTable
BUCKET_NAME=<DataStack output BucketName>

# API Gateway invoke URLs (AppStack outputs ManagementApiUrl / NetWorthApiUrl) and the API key value
MGMT_API_BASE_URL=https://<id>.execute-api.us-west-1.amazonaws.com/prod
NETWORTH_API_BASE_URL=https://<id>.execute-api.us-west-1.amazonaws.com/prod
MGMT_API_KEY=<aws apigateway get-api-key --api-key <ApiKeyId> --include-value>

# MessagingStack output TradeDecisionQueueUrl (or set TRADE_DECISION_QUEUE_NAME to resolve by name)
TRADE_DECISION_QUEUE_URL=https://sqs.us-west-1.amazonaws.com/<account>/<queue>

# Optional
# TRADE_QUANTITY=1          shares per AUTO_TRADE_DECISION
# AWS_ENDPOINT_URL=http://localhost:5000   point everything at an emulator
